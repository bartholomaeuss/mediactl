    "version": "0.2.0",
    "configurations": [

        {
            "name": "mediactl sidecar export (mkv)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "sidecar",
                "export",
                "--format", "mkv",
                "demo-data"
            ]
        },
        {
            "name": "mediactl sidecar export (mp4)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "sidecar",
                "export",
                "--format", "mp4",
                "demo-data"
            ]
        },
        {
            "name": "mediactl sidecar import",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "sidecar",
                "import",
                "demo-data/Asterix bei den Briten [tmdbid-9318].mp4.json"
            ]
        }
    ]
}
